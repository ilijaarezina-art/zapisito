{
  "expo": {
    "name": "ZapišiTo",
    "slug": "zapisito",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.zapisito.app",
      "versionCode": 10,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dozvolite pristup mikrofonu za glasovno diktiranje naloga, materijala i poslova.",
          "speechRecognitionPermission": "Dozvolite prepoznavanje govora za automatsko pretvaranje vašeg glasa u pisane zabeleške."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46a06f55-d494-49fc-9f19-d8be3010bc3d"
      }
    },
    "experiments": {
      "baseUrl": "/zapisito"
    },
    "owner": "ilijaarezina"
  }
}
